{
	"$schema": "https://developers.reddit.com/schema/config-file.v1.json",
	"name": "chess-war",
	"post": {
		"dir": "dist/client",
		"entrypoints": {
			"default": {
				"entry": "splash.html",
				"inline": true,
				"height": "tall"
			},
			"game": {
				"entry": "index.html"
			}
		}
	},
	"server": {
		"dir": "dist/server",
		"entry": "index.cjs"
	},
	"menu": {
		"items": [
			{
				"label": "Post Daily Challenge",
				"location": "subreddit",
				"forUserType": "moderator",
				"endpoint": "/internal/menu/daily-challenge-create"
			},
			{
				"label": "Reset Daily Lock",
				"location": "subreddit",
				"forUserType": "moderator",
				"endpoint": "/internal/menu/dev-reset-daily-lock"
			}
		]
	},
	"triggers": {
		"onAppInstall": "/internal/on-app-install"
	},
	"scheduler": {
		"tasks": {
			"post-daily-challenge": {
				"cron": "0 0 * * *",
				"endpoint": "/internal/scheduler/post-daily-challenge"
			}
		}
	},
	"dev": {
		"subreddit": "chess_war_dev"
	}
}
